# ==============================================================================
# Environment Configuration (.env.example)
# Dynamic Multi-Module Device Monitoring & Admin Platform
# ==============================================================================

# Database Settings
POSTGRES_DB=monitoringdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/monitoringdb

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379

# Application Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Spring Active Profile (dev for in-memory H2, prod for PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080
FRONTEND_PORT=5173
